# Copy to .env and fill in. Never commit the real .env file.

# Gemini API key (https://aistudio.google.com/apikey). Optional: without it the
# app runs in "offline guidance mode" using its built-in rule-based planner.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=8000
# UPSTREAM_TIMEOUT_MS=5000
# AIR_CACHE_TTL_MS=600000
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=40
# PORT=3000
# TRUST_PROXY=1   # set to 1 behind a single reverse proxy such as Cloud Run
